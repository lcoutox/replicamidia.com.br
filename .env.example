# Endereço público do site (links absolutos, RSS, sitemap e compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity. Com o projectId vazio, o site roda com o conteúdo de demonstração.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Segredo do webhook de revalidação (Sanity → /api/revalidate)
SANITY_REVALIDATE_SECRET=
